APP_NAME=Laravel
APP_ENV=local
APP_KEY=base64:Muwy7WDXoGpmgXe83HYvFNkk4Nq8UylE6elazV5iIoY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Старе підключення (локальний Sail) ---
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
# 480 = 8 годин: тривалість веб-сесії для входу на захищену Filament-панель
# за номером телефону + кодом (FR-020, feature 004). Це єдиний флоу застосунку,
# що використовує auth-сесію, тому значення піднято з дефолтних 120 до 480.
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=660

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"


OPENAI_API_KEY=key
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_VISION_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_TEMPERATURE=0.2
OPENAI_TOP_P=0.9
OPENAI_MAX_TOKENS=500
OPENAI_QUERY_REFINEMENT_ENABLED=true

RAG_SUPPORTED_LANGUAGES=uk,en,ru
RAG_SESSION_TIMEOUT_MINUTES=60
RAG_MAX_UPLOAD_MB=50
RAG_RATE_LIMIT_PER_MINUTE=30
RAG_PERMANENT_DELETION_AFTER_DAYS=30
RAG_SEARCH_TOP_K=3
RAG_SEARCH_MIN_RELEVANCE=30
RAG_CHUNK_MAX_LENGTH=700
RAG_DOCUMENT_DISK=public

WWWUSER=502
WWWGROUP=20

# --- Telegram-бот + авторизація та ролі (feature 004) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Груповий чат модерації (FR-004a): куди бот надсилає картки заявок на апрув
TELEGRAM_MODERATION_CHAT_ID=
# Фіксована мова картки заявки та кнопок у груповому чаті модерації (FR-004)
TELEGRAM_MODERATION_LANGUAGE=uk
# Одноразовий код для веб-входу (FR-019)
TELEGRAM_OTP_TTL_MINUTES=5
TELEGRAM_OTP_MAX_ATTEMPTS=3
# Тривалість веб-сесії після входу за кодом (FR-020) задається через
# SESSION_LIFETIME вище — окрема змінна не потрібна (єдиний guard у застосунку).
# Час щоденного нагадування про необроблені заявки (FR-007)
TELEGRAM_REMINDER_TIME=09:00
# Розмір сторінки пагінації списку документів у боті (FR-012a)
TELEGRAM_DOCS_PAGE_SIZE=20
# Окремий чат для технічних помилок webhook (не чат модерації — модераторам
# це бачити не треба). Якщо не задано — помилки лише логуються.
TELEGRAM_ERROR_CHAT_ID=


