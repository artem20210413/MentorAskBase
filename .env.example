#####################################################################
# Застосунок
#####################################################################
APP_NAME=Laravel
APP_ENV=local
# Генерується командою `php artisan key:generate` (робить і `composer setup`).
# Ніколи не комітьте реальний ключ.
APP_KEY=
APP_DEBUG=true
# Публічна адреса застосунку. Від неї будуються посилання на файли документів
# у відповідях (/storage/...), тож на проді — реальний HTTPS-домен.
APP_URL=http://localhost

# Мова адмінки, веб-чату, повідомлень API та помилок обробки документів
APP_LOCALE=uk
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

#####################################################################
# База даних — лише PostgreSQL з розширенням pgvector
#####################################################################
DB_CONNECTION=pgsql
# Значення під Sail: `pgsql` — ім'я сервісу Postgres у docker-мережі.
# Локально нічого не міняйте; на проді — дані свого сервера БД.
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=sail
DB_PASSWORD=password

#####################################################################
# Сесії, кеш, черги
#####################################################################
SESSION_DRIVER=database
# 480 = 8 годин: тривалість веб-сесії для входу на захищену Filament-панель
# за номером телефону + кодом (FR-020, feature 004). Це єдиний флоу застосунку,
# що використовує auth-сесію, тому значення піднято з дефолтних 120 до 480.
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Має бути більшим за timeout ProcessDocumentJob (600 с), інакше довгу обробку
# документа (OCR сканів) черга вважатиме зависанням і запустить вдруге.
DB_QUEUE_RETRY_AFTER=660

CACHE_STORE=database
# CACHE_PREFIX=

# Redis піднімається в Sail, але за замовчуванням не використовується
# (кеш/черги/сесії — у БД). Потрібен, лише якщо перемкнути драйвери на redis.
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Пошта застосунку не потрібна: коди входу приходять у Telegram
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

#####################################################################
# OpenAI — генерація відповідей, ембединги, OCR сканів
#####################################################################
OPENAI_API_KEY=
# OPENAI_ORGANIZATION=
# OPENAI_PROJECT=
# OPENAI_BASE_URL=
# Таймаут одного HTTP-запиту до OpenAI, с (агентний цикл і vision бувають довгими)
OPENAI_REQUEST_TIMEOUT=180

OPENAI_CHAT_MODEL=gpt-4o
OPENAI_VISION_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Розмірність вектора фіксується міграцією document_chunks. Зміна після
# наповнення бази = перестворення таблиці й переобробка всіх документів.
OPENAI_EMBEDDING_DIMENSIONS=1536

# Параметри генерації. Reasoning-моделі (o-серія, gpt-5) не приймають
# temperature/top_p — при переході на них див. коментар у config/rag.php.
OPENAI_TEMPERATURE=0.2
OPENAI_TOP_P=0.9
# Порожнє значення — без ліміту токенів у відповіді
OPENAI_MAX_TOKENS=500
# Переформулювати питання з урахуванням історії перед пошуком (QueryRewriter)
OPENAI_QUERY_REFINEMENT_ENABLED=true

#####################################################################
# RAG
#####################################################################
# Підтримувані мови відповіді; перша — мова за замовчуванням для решти мов
RAG_SUPPORTED_LANGUAGES=uk,en,ru
# Через скільки хвилин неактивності розмова починається з чистого аркуша
RAG_SESSION_TIMEOUT_MINUTES=60
RAG_MAX_UPLOAD_MB=50
# Ліміт запитів на хвилину: на API-токен і на IP для публічного /chat
RAG_RATE_LIMIT_PER_MINUTE=30
# Через скільки днів м'яко видалені документи стираються фізично
RAG_PERMANENT_DELETION_AFTER_DAYS=30
# Скільки найближчих фрагментів бази знань передавати моделі
RAG_SEARCH_TOP_K=3
# Мінімальна релевантність фрагмента (0–100, %), нижче — відкидається
RAG_SEARCH_MIN_RELEVANCE=30
# Максимальна довжина фрагмента (символів) при нарізці документа
RAG_CHUNK_MAX_LENGTH=700
# Диск для файлів документів. `public` дає пряме посилання /storage/...
# (потрібен `php artisan storage:link`)
RAG_DOCUMENT_DISK=public
# Ліміт кроків агента (виклики інструментів) на одне питання
RAG_AGENT_MAX_STEPS=4
# Обмежити веб-пошук доменами через кому; порожньо — без обмеження
RAG_WEB_SEARCH_ALLOWED_DOMAINS=

#####################################################################
# Telegram-бот + авторизація та ролі (feature 004)
#####################################################################
# Токен від @BotFather
TELEGRAM_BOT_TOKEN=
# Випадковий рядок; входить у шлях webhook: /api/telegram/webhook/{secret}
# Згенерувати: php -r "echo bin2hex(random_bytes(24)), PHP_EOL;"
TELEGRAM_WEBHOOK_SECRET=
# Груповий чат модерації (FR-004a): куди бот надсилає картки заявок на апрув.
# ID груп від'ємні, напр. -1001234567890
TELEGRAM_MODERATION_CHAT_ID=
# Фіксована мова картки заявки та кнопок у груповому чаті модерації (FR-004)
TELEGRAM_MODERATION_LANGUAGE=uk
# Окремий чат для технічних помилок webhook (не чат модерації — модераторам
# це бачити не треба). Якщо не задано — помилки лише логуються.
TELEGRAM_ERROR_CHAT_ID=
# true — обробка update воркером черги `telegram` (потрібен queue:work);
# false — одразу після відповіді webhook, без воркера
TELEGRAM_UPDATES_VIA_QUEUE=false

# Одноразовий код для веб-входу (FR-019)
TELEGRAM_OTP_TTL_MINUTES=5
TELEGRAM_OTP_MAX_ATTEMPTS=3
TELEGRAM_OTP_REQUESTS_PER_MINUTE=3
TELEGRAM_OTP_REQUESTS_PER_IP_PER_MINUTE=5
TELEGRAM_OTP_VERIFY_PER_IP_PER_MINUTE=10
# Тривалість веб-сесії після входу за кодом (FR-020) задається через
# SESSION_LIFETIME вище — окрема змінна не потрібна (єдиний guard у застосунку).

# Час щоденного нагадування про необроблені заявки (FR-007)
TELEGRAM_REMINDER_TIME=09:00
# Розмір сторінки пагінації списку документів у боті (FR-012a)
TELEGRAM_DOCS_PAGE_SIZE=20

# Ліміти вільного чату бота на одного користувача
TELEGRAM_FREE_CHAT_PER_MINUTE=10
TELEGRAM_FREE_CHAT_PER_DAY=100
TELEGRAM_QUESTION_MAX_LENGTH=2000

#####################################################################
# Laravel Sail (Docker)
#####################################################################
# UID/GID вашого користувача на хості (`id -u`, `id -g`). Скрипт sail
# підставляє їх сам; задавайте, лише якщо запускаєте `docker compose` напряму.
# WWWUSER=1000
# WWWGROUP=1000
# Порти на хості, якщо стандартні 80/5432/6379 зайняті іншими проєктами
# APP_PORT=8000
# FORWARD_DB_PORT=5432
# FORWARD_REDIS_PORT=6379
